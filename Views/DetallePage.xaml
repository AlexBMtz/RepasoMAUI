<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:Class="RepasoMAUI.Views.DetallePage"
             x:DataType="vm:DetalleViewModel"
             Title="Detalle del Producto">

    <Grid>
        <!-- Estado de carga -->
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Estado de error -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="15"
                             Padding="20">

            <Label Text="⚠️ Ocurrió un error"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="14"
                   HorizontalTextAlignment="Center" />

            <Button Text="Reintentar"
                    Command="{Binding CargarProductoCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Contenido del producto -->
        <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Padding="20"
                                 Spacing="15"
                                 IsVisible="{Binding HasError, Converter={StaticResource InvertedBoolConverter}}">

                <Image Source="{Binding Producto.ImagenUrl}"
                       HeightRequest="250"
                       Aspect="AspectFit" />

                <Label Text="{Binding Producto.Nombre}"
                       FontSize="22"
                       FontAttributes="Bold" />

                <Label Text="{Binding Producto.Categoria}"
                       FontSize="14"
                       TextColor="SlateGray"
                       FontAttributes="Italic" />

                <Label Text="{Binding Producto.Precio, StringFormat='${0:N2}'}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="DarkGreen" />

                <Label Text="{Binding Producto.Descripcion}"
                       FontSize="14"
                       TextColor="Gray" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>