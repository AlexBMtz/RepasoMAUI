<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:Class="RepasoMAUI.Views.DetallePage"
             x:DataType="vm:DetalleViewModel"
             Title="Detalle del Producto">

    <Grid Padding="20">
        <!-- 1. Estado de Carga -->
        <VerticalStackLayout IsVisible="{Binding IsLoading}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="15">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Primary}"
                               WidthRequest="50"
                               HeightRequest="50" />
            <Label Text="Cargando información del producto..."
                   FontSize="14"
                   TextColor="{StaticResource Gray500}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- 2. Estado de Error -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="15"
                             Padding="20">
            <Label Text="⚠ Error al cargar"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#D32F2F"
                   HorizontalOptions="Center" />

            <Label Text="{Binding ErrorMessage}"
                   FontSize="15"
                   TextColor="{StaticResource Gray600}"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <Button Text="Reintentar"
                    Command="{Binding ReintentarCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    CornerRadius="8"
                    HorizontalOptions="Center"
                    Margin="0,10,0,0" />
        </VerticalStackLayout>

        <!-- 3. Contenido del Producto (Happy Path) -->
        <ScrollView IsVisible="{Binding HasError, Converter={StaticResource InvertedBoolConverter}}">
            <VerticalStackLayout Spacing="15"
                                 IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

                <!-- Imagen del producto -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Gray200}"
                        StrokeThickness="1"
                        BackgroundColor="{StaticResource White}"
                        Padding="15"
                        HeightRequest="260">
                    <Image Source="{Binding Producto.ImagenUrl}"
                           Aspect="AspectFit"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Categoría -->
                <Border StrokeShape="RoundRectangle 6"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource Secondary}"
                        Padding="8,4"
                        HorizontalOptions="Start">
                    <Label Text="{Binding Producto.Categoria}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Tertiary}"
                           TextTransform="Uppercase" />
                </Border>

                <!-- Título / Nombre -->
                <Label Text="{Binding Producto.Nombre}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <!-- Precio -->
                <Label Text="{Binding Producto.Precio, StringFormat='${0:N2}'}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#2E7D32" />

                <!-- Separador -->
                <BoxView HeightRequest="1"
                         Color="{StaticResource Gray200}"
                         Margin="0,5" />

                <!-- Descripción -->
                <Label Text="Descripción"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <Label Text="{Binding Producto.Descripcion}"
                       FontSize="14"
                       LineHeight="1.3"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>