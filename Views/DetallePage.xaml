<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:Class="RepasoMAUI.Views.DetallePage"
             x:DataType="vm:DetalleViewModel"
             Title="Detalle del producto">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="15">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HeightRequest="40"
                               WidthRequest="40"
                               HorizontalOptions="Center" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="Red"
                   FontSize="16"
                   Margin="0,10" />

            <Button Text="Reintentar"
                    Command="{Binding RetryCommand}"
                    IsVisible="{Binding HasError}"
                    HorizontalOptions="Center" />

            <VerticalStackLayout IsVisible="{Binding HasError, Converter={StaticResource InvertedBoolConverter}}"
                                 Spacing="10">
                <Image Source="{Binding Producto.ImagenUrl}"
                       HeightRequest="220"
                       Aspect="AspectFit" />

                <Label Text="{Binding Producto.Nombre}"
                       FontSize="22"
                       FontAttributes="Bold" />

                <Label Text="{Binding Producto.Categoria, StringFormat='Categoría: {0}'}"
                       FontSize="14"
                       TextColor="Gray" />

                <Label Text="{Binding Producto.Precio, StringFormat='${0:N2}'}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="DarkGreen" />

                <Label Text="{Binding Producto.Descripcion}"
                       FontSize="14"
                       TextColor="Gray" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>