<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:Class="RepasoMAUI.Views.DetallePage"
             x:DataType="vm:DetalleViewModel"
             Title="DetallePage"
             >

    <Grid Padding="20">

        <!-- Estado: cargando -->
        <VerticalStackLayout IsVisible="{Binding IsLoading}"
                             VerticalOptions="Center"
                             Spacing="10">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               HeightRequest="50"
                               WidthRequest="50" />
            <Label Text="Cargando producto..."
                   HorizontalOptions="Center"
                   TextColor="Gray" />
        </VerticalStackLayout>

        <!-- Estado: error -->
        <VerticalStackLayout IsVisible="{Binding HasError}"
                             VerticalOptions="Center"
                             Spacing="15"
                             Padding="20">
            <Label Text="⚠️"
                   FontSize="40"
                   HorizontalOptions="Center" />
            <Label Text="{Binding ErrorMessage}"
                   FontSize="16"
                   TextColor="IndianRed"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Button Text="Reintentar"
                    Command="{Binding ReintentarCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Estado: contenido normal -->
        <VerticalStackLayout IsVisible="{Binding MostrarContenido}"
                             Spacing="15">

            <Image Source="{Binding Producto.ImagenUrl}"
                   HeightRequest="200"
                   Aspect="AspectFit" />

            <Label Text="{Binding Producto.Nombre}"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label Text="{Binding Producto.Categoria}"
                   FontSize="13"
                   TextColor="Gray"
                   FontAttributes="Italic" />

            <Label Text="{Binding Producto.Descripcion}"
                   FontSize="14"
                   TextColor="Gray" />

            <Label Text="{Binding Producto.Precio, StringFormat='${0:N2}'}"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="DarkGreen" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>