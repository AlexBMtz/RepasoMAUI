<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RepasoMAUI.Models"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:Class="RepasoMAUI.Views.FavoritosPage"
             x:DataType="vm:FavoritosViewModel"
             x:Name="favoritosPage"
             Title="Favoritos">

    <CollectionView ItemsSource="{Binding Favoritos}"
                    Margin="10">

        <CollectionView.EmptyView>

            <VerticalStackLayout Padding="30"
                                 Spacing="10"
                                 VerticalOptions="Center">

                <Label Text="No tienes favoritos"
                       FontSize="20"
                       HorizontalOptions="Center" />

                <Label Text="Agrega productos desde la página de detalle."
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>

        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>

            <DataTemplate x:DataType="models:Producto">

                <Grid Padding="10"
                      ColumnDefinitions="80,*,Auto">

                    <Image Source="{Binding ImagenUrl}"
                           HeightRequest="60"
                           WidthRequest="60"
                           Aspect="AspectFill"
                           Grid.Column="0" />

                    <VerticalStackLayout Grid.Column="1"
                                         Margin="10,0,0,0"
                                         VerticalOptions="Center">

                        <Label Text="{Binding Nombre}"
                               FontAttributes="Bold"
                               FontSize="16" />

                        <Label Text="{Binding Precio, StringFormat='${0:N2}'}"
                               FontSize="14"
                               TextColor="DarkGreen" />

                    </VerticalStackLayout>

                    <Button Text="Eliminar"
                            Grid.Column="2"
                            VerticalOptions="Center"
                            Command="{Binding BindingContext.EliminarFavoritoCommand, Source={x:Reference favoritosPage}}"
                            CommandParameter="{Binding .}" />

                </Grid>

            </DataTemplate>

        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>