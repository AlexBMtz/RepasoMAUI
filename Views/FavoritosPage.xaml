<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RepasoMAUI.Models"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:Class="RepasoMAUI.Views.FavoritosPage"
             x:DataType="vm:FavoritosViewModel"
             Title="Favoritos">

    <VerticalStackLayout Padding="10">

        <Label Text="Mis Favoritos"
               FontSize="24"
               FontAttributes="Bold"
               Margin="10" />

        <CollectionView ItemsSource="{Binding Productos}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">

                    <Label Text="No tienes productos favoritos."
                           FontSize="18"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Agrega productos desde la pantalla de Detalle."
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Producto">

                    <Grid Padding="10"
                          ColumnDefinitions="80,*,Auto">

                        <Image Source="{Binding ImagenUrl}"
                               HeightRequest="70"
                               WidthRequest="70"
                               Aspect="AspectFill"
                               Grid.Column="0" />

                        <VerticalStackLayout Grid.Column="1"
                                             Margin="10,0,0,0"
                                             VerticalOptions="Center">

                            <Label Text="{Binding Nombre}"
                                   FontSize="16"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding Precio, StringFormat='${0:N2}'}"
                                   FontSize="15"
                                   TextColor="DarkGreen"
                                   FontAttributes="Bold" />

                        </VerticalStackLayout>

                        <Button Text="Eliminar"
                                Grid.Column="2"
                                VerticalOptions="Center"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritosViewModel}}, Path=EliminarFavoritoCommand}"
                                CommandParameter="{Binding .}" />

                    </Grid>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>